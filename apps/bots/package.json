{
  "name": "@float/bots",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "standalone": "tsx src/standalone.ts",
    "tick": "tsx src/tick.ts",
    "snapshot": "tsx src/snapshot.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@float/core": "workspace:*",
    "@float/db": "workspace:*",
    "@meteora-ag/cp-amm-sdk": "^1.1.0",
    "@meteora-ag/dynamic-bonding-curve-sdk": "^1.4.0",
    "@sentry/node": "^8.47.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0",
    "bn.js": "^5.2.1",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "pino": "^9.5.0",
    "pino-loki": "^2.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "vitest": "^2.1.8"
  }
}

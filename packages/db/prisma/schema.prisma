// Float-on-Meteora Postgres schema.
// Amounts are stored in base units as BigInt (int8). 1B supply * 1e6 decimals
// = 1e15, well within int64; quote lamports likewise.

generator client {
  provider = "prisma-client-js"
  // "native" for local dev; the rhel target is for Vercel's serverless runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SwapSide {
  Buy
  Sell
}

enum SwapVenue {
  DBC
  DAMM
}

/// One DBC PoolConfig per quote mint (lazily created at first launch).
model PoolConfig {
  quoteMint    String   @id @map("quote_mint")
  configPubkey String   @map("config_pubkey")
  createdAt    DateTime @default(now()) @map("created_at")
  createdByTx  String   @map("created_by_tx")
  /// When true, cycle/payout skip every coin on this quote mint.
  paused       Boolean  @default(false)

  @@map("pool_configs")
}

/// A launched coin and its lifecycle pointers.
model Coin {
  pool            String   @id
  baseMint        String   @map("base_mint")
  quoteMint       String   @map("quote_mint")
  config          String
  creator         String // on-chain pool creator
  creatorWallet   String?  @map("creator_wallet") // UI user wallet, if known
  ticker          String
  name            String
  uri             String
  launchedAt      DateTime @default(now()) @map("launched_at")
  migrationState  Int      @default(0) @map("migration_state")
  dammPool        String?  @map("damm_pool")
  partnerPosition String?  @map("partner_position")

  swaps   Swap[]
  holders Holder[]

  @@index([quoteMint])
  @@map("coins")
}

/// A single swap (DBC bonding curve or migrated DAMM v2). Idempotent on
/// (sig, eventIndex) so duplicate webhook deliveries collapse.
model Swap {
  sig         String    @map("sig")
  eventIndex  Int       @default(0) @map("event_index")
  slot        BigInt
  ts          DateTime
  pool        String
  wallet      String
  side        SwapSide
  venue       SwapVenue @default(DBC)
  baseAmount  BigInt    @map("base_amount")
  quoteAmount BigInt    @map("quote_amount")
  feeAmount   BigInt    @map("fee_amount")
  referral    Boolean   @default(false)

  coin Coin @relation(fields: [pool], references: [pool])

  @@id([sig, eventIndex])
  @@index([pool, ts])
  @@index([wallet, ts])
  @@map("swaps")
}

/// Per-coin, per-wallet base-token balance, maintained from swap deltas and
/// corrected by resnapshot.
model Holder {
  coin        String
  wallet      String
  balance     BigInt @default(0)
  updatedSlot BigInt @map("updated_slot")

  coinRef Coin @relation(fields: [coin], references: [pool])

  @@id([coin, wallet])
  @@index([coin])
  @@map("holders")
}

/// A claimed fee amount and its 15/5/35/35/10 split (quote-denominated).
model FeeClaim {
  id             String   @id @default(cuid())
  claimTx        String   @unique @map("claim_tx")
  pool           String
  ts             DateTime @default(now())
  mint           String
  totalClaimed   BigInt   @map("total_claimed")
  holdersAmount  BigInt   @map("holders_amount")
  creatorAmount  BigInt   @map("creator_amount")
  flagshipAmount BigInt   @map("flagship_amount")
  tradersAmount  BigInt   @map("traders_amount")
  treasuryAmount BigInt   @map("treasury_amount")

  @@index([pool, ts])
  @@map("fee_claims")
}

model PayoutRound {
  id          String   @id @default(cuid())
  coin        String
  mint        String
  status      String   @default("pending")
  totalAmount BigInt   @map("total_amount")
  createdAt   DateTime @default(now()) @map("created_at")

  payouts Payout[]

  @@index([coin])
  @@map("payout_rounds")
}

model Payout {
  id        String   @id @default(cuid())
  roundId   String   @map("round_id")
  coin      String
  wallet    String
  mint      String
  amount    BigInt
  tx        String?
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")

  round PayoutRound @relation(fields: [roundId], references: [id])

  @@unique([roundId, wallet])
  @@index([coin, wallet])
  @@map("payouts")
}

model Buyback {
  id          String   @id @default(cuid())
  ts          DateTime @default(now())
  mint        String
  solIn       BigInt   @map("sol_in")
  flagshipOut BigInt   @map("flagship_out")
  swapTx      String?  @map("swap_tx")
  burnTx      String?  @map("burn_tx")

  @@index([ts])
  @@map("buybacks")
}

model AirdropRound {
  id          String   @id @default(cuid())
  windowStart DateTime @map("window_start")
  windowEnd   DateTime @map("window_end")
  status      String   @default("pending_review")
  createdAt   DateTime @default(now()) @map("created_at")

  airdrops Airdrop[]

  @@map("airdrop_rounds")
}

model Airdrop {
  id      String  @id @default(cuid())
  roundId String  @map("round_id")
  wallet  String
  mint    String
  amount  BigInt
  volume  BigInt
  tx      String?
  status  String  @default("pending")

  round AirdropRound @relation(fields: [roundId], references: [id])

  @@unique([roundId, wallet])
  @@index([wallet])
  @@map("airdrops")
}

enum TxStatus {
  SIMULATED
  SENT
  CONFIRMED
  FAILED
}

/// One row per on-chain send attempt by a bot (idempotency + audit trail).
model TxLog {
  id        String   @id @default(cuid())
  ts        DateTime @default(now())
  bot       String
  action    String
  status    TxStatus
  attempt   Int      @default(1)
  signature String?
  pool      String?
  mint      String?
  dryRun    Boolean  @default(false) @map("dry_run")
  /// Deterministic idempotency key for the action this attempt belongs to.
  idemKey   String?  @map("idem_key")
  error     String?

  @@index([bot, ts])
  @@index([idemKey])
  @@map("tx_log")
}

/// Pending quote owed to the holders of a coin (credited by cycle, debited by payout).
model HoldersPool {
  coin   String
  mint   String
  amount BigInt @default(0)

  @@id([coin, mint])
  @@map("holders_pool")
}

/// Pending quote earmarked for the flagship buyback, per mint.
model FlagshipPool {
  mint   String @id
  amount BigInt @default(0)

  @@map("flagship_pool")
}

/// Pending quote earmarked for the trader airdrop, per mint.
model TradersPool {
  mint   String @id
  amount BigInt @default(0)

  @@map("traders_pool")
}

/// Indexer progress, keyed by a logical stream id (e.g. "dbc", "damm").
model Cursor {
  id        String   @id
  lastSlot  BigInt   @map("last_slot")
  lastSig   String?  @map("last_sig")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cursor")
}

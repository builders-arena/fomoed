# ---------------------------------------------------------------------------
# Float-on-Meteora environment. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# Cluster: "devnet" (default) or "mainnet-beta". Mainnet requires explicit opt-in.
CLUSTER=devnet

# RPC endpoints (Helius recommended). Devnet key for dev, mainnet key for prod.
RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_DEVNET_KEY
# Optional: separate endpoint used only for sending txs (can equal RPC_URL).
RPC_SEND_URL=

# ---------------------------------------------------------------------------
# Wallets. Either a path to a JSON keypair file, or a base58 secret key string.
# On devnet these may be plain keypairs; on mainnet fee_claimer/treasury should
# be Squads multisig addresses (set the *_ADDRESS vars instead of *_KEYPAIR).
# ---------------------------------------------------------------------------

# Admin / deployer keypair (pays rent, runs scripts).
ADMIN_KEYPAIR=./wallets/admin.json

# Fee claimer: receives claimed partner fees. Squads multisig on mainnet.
FEE_CLAIMER_KEYPAIR=./wallets/fee-claimer.json
FEE_CLAIMER_ADDRESS=

# Receives leftover base tokens after migration.
LEFTOVER_RECEIVER_ADDRESS=

# Bot hot wallets.
PAYOUT_KEYPAIR=./wallets/payout.json
BUYBACK_KEYPAIR=./wallets/buyback.json
AIRDROP_KEYPAIR=./wallets/airdrop.json

# Treasury (receives the 10% share). Multisig on mainnet.
TREASURY_ADDRESS=

# ---------------------------------------------------------------------------
# Safety
# ---------------------------------------------------------------------------

# When true, bots and scripts build + simulate txs but never send.
DRY_RUN=true

# ---------------------------------------------------------------------------
# Infra (used from Phase 3 onwards)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://float:float@localhost:5432/float?schema=public
REDIS_URL=redis://localhost:6379
HELIUS_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Bots (Phase 4)
# ---------------------------------------------------------------------------
ADMIN_API_TOKEN=
ADMIN_API_PORT=8788
FLAGSHIP_MINT=

# ---------------------------------------------------------------------------
# Web app (Phase 5). NEXT_PUBLIC_* are inlined into the browser bundle.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLUSTER=devnet
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:8788
# Server-side only (config creation + cycle proxy): FEE_CLAIMER_ADDRESS,
# LEFTOVER_RECEIVER_ADDRESS, ADMIN_API_TOKEN, RPC_URL, DATABASE_URL (above).
